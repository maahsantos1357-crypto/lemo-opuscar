 "cues": [
  {
   "t0": 0.95,
   "t1": 4.83,
   "text": "Uma notificação. Bônus de 50 reais.",
   "line": "L1"
  },
  {
   "t0": 4.85,
   "t1": 6.07,
   "text": "Aposte agora.",
   "line": "L1"
  },
  {
   "t0": 7.27,
   "t1": 10.21,
   "text": "Este é o arquivo de um esquema que cabe no bolso de",
   "line": "L2"
  },
  {
   "t0": 10.23,
   "t1": 13.15,
   "text": "milhões de brasileiros: as bets.",
   "line": "L2"
  },
  {
   "t0": 13.25,
   "t1": 15.41,
   "text": "Prova número um: a isca.",
   "line": "L3"
  },
  {
   "t0": 15.43,
   "t1": 19.81,
   "text": "Bônus de boas-vindas, propaganda na camisa do seu time, e",
   "line": "L3"
  },
  {
   "t0": 19.83,
   "t1": 23.77,
   "text": "influenciadores mostrando ganhos que você nunca vê de perto.",
   "line": "L3"
  },
  {
   "t0": 23.87,
   "t1": 26.81,
   "text": "Prova número dois: a matemática.",
   "line": "L4"
  },
  {
   "t0": 26.83,
   "t1": 29.69,
   "text": "Em cada aposta, a casa embute uma margem.",
   "line": "L4"
  },
  {
   "t0": 29.71,
   "t1": 33.669999999999995,
   "text": "Nos cassinos online, as máquinas são programadas para",
   "line": "L4"
  },
  {
   "t0": 33.69,
   "t1": 36.11,
   "text": "devolver menos do que recebem.",
   "line": "L4"
  },
  {
   "t0": 36.31,
   "t1": 38.91,
   "text": "Você pode até ganhar uma vez.",
   "line": "L5"
  },
  {
   "t0": 38.93,
   "t1": 42.73,
   "text": "Mas quanto mais joga, mais perto chega da conta final:",
   "line": "L5"
  },
  {
   "t0": 42.75,
   "t1": 44.67,
   "text": "a casa sempre ganha.",
   "line": "L5"
  },
  {
   "t0": 44.77,
   "t1": 47.61,
   "text": "Prova número três: as vítimas.",
   "line": "L6"
  },
  {
   "t0": 47.63,
   "t1": 51.129999999999995,
   "text": "Segundo o Banco Central, cerca de 24 milhões de",
   "line": "L6"
  },
  {
   "t0": 51.15,
   "t1": 54.62,
   "text": "brasileiros apostaram em 2024.",
   "line": "L6"
  },
  {
   "t0": 54.64,
   "t1": 59.18,
   "text": "Só em agosto daquele ano, beneficiários do Bolsa Família",
   "line": "L7"
  },
  {
   "t0": 59.2,
   "t1": 64.06,
   "text": "enviaram 3 bilhões de reais às bets, via Pix.",
   "line": "L7"
  },
  {
   "t0": 64.46,
   "t1": 67.10000000000001,
   "text": "Prova número quatro: os danos.",
   "line": "L8"
  },
  {
   "t0": 67.12,
   "t1": 70.36,
   "text": "Dívidas. Nome sujo. Ansiedade.",
   "line": "L8"
  },
  {
   "t0": 70.38,
   "t1": 74.52,
   "text": "Vício. O dinheiro do aluguel e do mercado virando aposta.",
   "line": "L8"
  },
  {
   "t0": 75.52,
   "t1": 78.2,
   "text": "Agora, a pergunta que importa:",
   "line": "L9"
  },
  {
   "t0": 78.22,
   "t1": 79.84,
   "text": "quem realmente lucra?",
   "line": "L9"
  },
  {
   "t0": 80.84,
   "t1": 85.82000000000001,
   "text": "As operadoras, muitas ligadas a grupos estrangeiros, ficam",
   "line": "L10"
  },
  {
   "t0": 85.84,
   "t1": 89.16,
   "text": "com a diferença entre o que entra e o que sai.",
   "line": "L10"
  },
  {
   "t0": 89.21,
   "t1": 93.05,
   "text": "Alguns influenciadores ganham comissão sobre o quanto seus",
   "line": "L11"
  },
  {
   "t0": 93.07,
   "t1": 98.01,
   "text": "seguidores perdem. Quanto mais você perde, mais eles ganham.",
   "line": "L11"
  },
  {
   "t0": 98.06,
   "t1": 101.68,
   "text": "Clubes e emissoras recebem milhões em patrocínio.",
   "line": "L12"
  },
  {
   "t0": 101.7,
   "t1": 104.92,
   "text": "E o apostador? Fica com o prejuízo.",
   "line": "L12"
  },
  {
   "t0": 106.72,
   "t1": 109.34,
   "text": "O veredito: não é sorte.",
   "line": "L13"
  },
  {
   "t0": 109.36,
   "t1": 113.58,
   "text": "É um modelo de negócio. E ele foi desenhado para você perder.",
   "line": "L13"
  },
  {
   "t0": 116.48,
   "t1": 120.24000000000001,
   "text": "Se o jogo deixou de ser diversão, procure ajuda.",
   "line": "L14"
  },
  {
   "t0": 120.26,
   "t1": 124.88,
   "text": "O CVV atende de graça, pelo 188.",
   "line": "L14"
  }
 ]
